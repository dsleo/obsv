{
  "name": "observatoire-presidentielle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run data:prepare",
    "dev": "next dev",
    "data:collect": "node --env-file-if-exists=.env scripts/collect-data.mjs",
    "data:validate": "node scripts/prepare-data.mjs --validate-only",
    "data:prepare": "node scripts/prepare-data.mjs",
    "build": "npm run data:prepare && next build",
    "start": "next start",
    "typecheck": "npm run data:prepare && tsc --noEmit",
    "data:analyze": "tsx scripts/analyze-events.ts",
    "data:check-analyses": "tsx scripts/check-analyses.ts",
    "data:approve": "tsx scripts/approve-analysis.ts",
    "data:fetch-index": "node scripts/radar/fetch-index.mjs",
    "test": "node --test scripts/validate.test.mjs scripts/events-api.test.mjs && vitest run pipeline src",
    "smoke": "node scripts/smoke-routes.mjs",
    "data:retag": "tsx scripts/radar/retag-index.ts"
  },
  "dependencies": {
    "lucide-react": "^0.479.0",
    "next": "^15.5.19",
    "openai": "^7.45.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.12",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}

{
  "name": "observatoire-presidentielle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run data:prepare",
    "dev": "next dev",
    "data:collect": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/collect-data.mjs",
    "data:validate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prepare-data.mjs --validate-only",
    "data:prepare": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prepare-data.mjs",
    "build": "npm run data:prepare && npm run release:check && next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "npm run data:prepare && tsc --noEmit",
    "data:backtest": "tsx scripts/backtest-pairs.ts",
    "data:analyze": "tsx scripts/analyze-events.ts",
    "data:check-analyses": "tsx scripts/check-analyses.ts",
    "data:approve": "tsx scripts/approve-analysis.ts",
    "data:fetch-index": "node scripts/radar/fetch-index.mjs",
    "test": "node --test scripts/validate.test.mjs scripts/events-api.test.mjs scripts/sondax.test.mjs scripts/publication.test.mjs scripts/snapshot.test.mjs && vitest run pipeline src",
    "smoke": "node scripts/smoke-routes.mjs",
    "data:retag": "tsx scripts/radar/retag-index.ts",
    "trust:refresh": "node --env-file-if-exists=.env scripts/trust-refresh.mjs",
    "release:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-release.mjs",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "lucide-react": "^0.479.0",
    "next": "^15.5.19",
    "openai": "^7.45.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}

# Offline analysis only (npm run data:analyze). Never exposed to the site.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local, ignored datasets: provision them before running the analysis.
# Ontology fr-electorate-5 indexes: build them from a v4 index with `npm run data:retag <calibrated.jsonl> <personas.jsonl>`.
RADAR_PERSONA_INDEX=data/radar/complete-communes-calibrated-v5.jsonl
RADAR_GEOGRAPHY_INDEX=data/radar/geography-2026.json
RADAR_GLOBAL_PERSONA_INDEX=data/radar/personas-v5.jsonl
